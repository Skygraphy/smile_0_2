<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A Frame comes back after a reboot (BootCompletedReceiver; only in Frame mode). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Runtime-prompted on Android 13+ by firebase_messaging's
         requestPermission(); needed to show a system-tray notification
         for a join request, an approval, or a new photo (data-only
         messages, like smile-frame's own sync-nudge, don't need this). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- image_picker's camera source (avatar upload, "Foto aufnehmen"),
         requested at runtime by the plugin, but still has to be declared. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- "Aus Kontakten" einladen (2026-10-17): read only, asked at runtime
         after Smile's own explanation; only hashed email addresses leave
         the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Invite links (2026-10-17): smileapp.app/i/CODE and a card's
                 smileapp.app/@name open Smile;
                 verified through smileapp.app/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="smileapp.app" android:pathPrefix="/i/"/>
                <data android:scheme="https" android:host="smileapp.app" android:pathPrefix="/@"/>
            </intent-filter>
            <!-- The links are handled by InviteLinks (app_links), not by
                 Flutter's own router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- The home screen entry (2026-10-17): SmileApp on a phone,
             SmileFrame with its own icon on a Frame. Exactly one is enabled;
             MainActivity.setLauncher switches them with the Frame mode. -->
        <activity-alias
            android:name=".AppLauncher"
            android:targetActivity=".MainActivity"
            android:label="${appLabel}"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".FrameLauncher"
            android:targetActivity=".MainActivity"
            android:label="${frameLabel}"
            android:icon="@mipmap/ic_launcher_frame"
            android:roundIcon="@mipmap/ic_launcher_frame_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Every push (also while the app is closed) uses the Smile channel
             with heads-up importance and the Smile status bar icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="smile_events" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_smile" />
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The SMS, WhatsApp and email apps an invite is sent with. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
