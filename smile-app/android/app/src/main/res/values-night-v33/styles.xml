<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 13 and newer (2026-10-17): the system's own start screen
         replaces launch_background. icon_preferred shows the Smile mark
         also when Smile is opened from a link or another app, where
         Android otherwise shows a plain, black looking screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
