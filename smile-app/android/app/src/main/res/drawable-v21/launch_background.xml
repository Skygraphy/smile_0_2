<?xml version="1.0" encoding="utf-8"?>
<!-- Shown until Flutter draws its first frame (2026-10-17): the Smile mark
     on the app's dark surface, so a start (also from an invite link or a
     card) never looks like a frozen black screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/splash_mark" />
</layer-list>
